{
  "name": "@eox/storytelling",
  "version": "1.13.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:EOX-A/EOxElements.git"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=24.0.0"
  },
  "files": [
    "types",
    "dist",
    "src"
  ],
  "main": "./src/main.js",
  "types": "./types/main.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./types/main.d.ts"
      ],
      "src/*": [
        "./types/*"
      ]
    }
  },
  "scripts": {
    "types:generate": "tsc --project tsconfig.build.json || true",
    "prepack": "npm run types:generate",
    "build": "vite build",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@eox/elements-utils": "^1.2.0",
    "@eox/ui": "^1.1.0",
    "@sindresorhus/slugify": "^3.0.1",
    "glightbox": "^3.3.0",
    "isomorphic-dompurify": "^4.5.0",
    "joi": "^18.2.9",
    "js-yaml": "^5.4.3",
    "lit": "^3.3.3",
    "lodash.debounce": "^4.0.8",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0"
  },
  "peerDependencies": {
    "@eox/jsonform": "*"
  }
}
